# PostgreSQL (сервис db в docker compose)
POSTGRES_USER=scorecast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scorecast
DATABASE_URL=postgresql+asyncpg://scorecast:change-me@db:5432/scorecast

# LLM: любой OpenAI-совместимый API. Без ключа резюме пропускаются, остальной конвейер работает
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Опционально: семантические эмбеддинги через тот же API. Без модели похожие считаются по признакам игры
EMBEDDING_MODEL=

# Публичный адрес сервиса и часовой пояс (граница «сегодня» для обхода)
PUBLIC_URL=https://games.1-lab.online
TZ=Europe/Moscow

# Летсплеи: YouTube отдаёт субтитры с IP датацентров с ошибкой 429. Если нужно, прокси вида http://user:pass@host:port
# YOUTUBE_PROXY=

# Необязательные параметры (значения по умолчанию)
# GAMES_PER_RUN=20
# CRAWL_CRON_MINUTE=0
# REQUEST_DELAY_SEC=1.0
# LLM_PRICE_IN=0.40
# LLM_PRICE_OUT=1.60
# EMBEDDING_PRICE=0.02
